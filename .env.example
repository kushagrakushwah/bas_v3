# SecureForge Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# -----------------------------------------------------------
# REQUIRED: Generate a strong random key for API authentication
# Run: openssl rand -hex 32
# -----------------------------------------------------------
API_KEY=

# -----------------------------------------------------------
# REQUIRED: Generate a strong secret for NextAuth.js session signing
# Run: openssl rand -base64 32
# -----------------------------------------------------------
NEXTAUTH_SECRET=

# -----------------------------------------------------------
# REQUIRED: PostgreSQL credentials
# Use strong, unique credentials in production
# -----------------------------------------------------------
POSTGRES_USER=secureforge
POSTGRES_PASSWORD=
POSTGRES_DB=secureforge

# -----------------------------------------------------------
# OPTIONAL: Deployment URLs
# -----------------------------------------------------------
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------
# OPTIONAL: Environment (development / production)
# -----------------------------------------------------------
ENVIRONMENT=production
