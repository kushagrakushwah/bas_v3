# ============================================================
# SecureForge Runtime Configuration
# ============================================================
# IMPORTANT: This file is excluded from git via .gitignore.
# Never commit real credentials. Generate strong values with:
#   openssl rand -hex 32      (for API_KEY, NEXTAUTH_SECRET)
#   openssl rand -base64 32   (for passwords)
# ============================================================

# --- API Authentication (REQUIRED) ---
# Must be at least 32 hex characters. Rotate immediately if exposed.
API_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# --- NextAuth Session Signing (REQUIRED) ---
# Must be cryptographically random. Same value must be set in secureforge-frontend.
NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# --- PostgreSQL (REQUIRED) ---
POSTGRES_USER=secureforge
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=secureforge

# --- Dashboard Login Credentials (REQUIRED) ---
# These gate access to the entire dashboard UI.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
OPERATOR_PASSWORD=REPLACE_WITH_STRONG_OPERATOR_PASSWORD

# --- Redis Broker Auth (REQUIRED) ---
# Must match --requirepass in docker-compose.yml.
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# --- Elasticsearch Security (REQUIRED when xpack.security.enabled=true) ---
ELASTIC_PASSWORD=REPLACE_WITH_STRONG_ELASTIC_PASSWORD

# --- Deployment URLs (OPTIONAL) ---
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=production

# --- Lab Targets (OPTIONAL) ---
# Comma-separated private IPs that bypass the SSRF block for authorized testing.
# NEVER include real production IPs here.
LAB_TARGETS=

# --- SMTP Alerting (OPTIONAL) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
